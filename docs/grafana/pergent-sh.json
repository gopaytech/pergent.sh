    {
      "type": "timeseries",
      "title": "Reviews by trigger",
      "description": "push is a push or an opened change, start a review someone with write access started, rerun and rerun_failed a re-run on request.",
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (trigger) (increase(pergent_reviews_total{platform_instance=~\"$platform_instance\",repository=~\"$repository\",repository!=\"(switched off)\"}[$__interval]))",
          "legendFormat": "{{trigger}}",
          "refId": "A",
          "instant": false,
          "range": true
