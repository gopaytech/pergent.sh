          "qryType": 1,
          "query": "label_values(pergent_skill_runs_total{platform_instance=~\"$platform_instance\"}, skill)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(pergent_skill_runs_total{platform_instance=~\"$platform_instance\"}, skill)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
