        "definition": "label_values(pergent_tokens_total{platform_instance=~\"$platform_instance\"}, model)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
